{
  "permissions": {
    "ask": [
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git push*)",
      "Bash(git merge*)",
      "Bash(git rebase*)",
      "Bash(git reset*)",
      "Bash(git checkout*)",
      "Bash(git switch*)",
      "Bash(git clean*)",
      "Bash(git branch -d*)",
      "Bash(git branch -D*)",
      "Bash(git tag -d*)",
      "Bash(git rm*)",
      "Bash(git mv*)",
      "Bash(git stash drop*)",
      "Bash(git stash clear*)",
      "Bash(git revert*)",
      "Bash(git cherry-pick*)",
      "Bash(git filter-branch*)",
      "Bash(rm*)",
      "Bash(rmdir*)",
      "Bash(unlink*)",
      "Bash(shred*)",
      "Bash(truncate*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/guard_results_bash.sh",
            "timeout": 10,
            "statusMessage": "実験結果の削除/上書きをチェック中..."
          }
        ]
      },
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/guard_results_write.sh",
            "timeout": 10,
            "statusMessage": "実験結果の上書きをチェック中..."
          }
        ]
      }
    ]
  }
}
